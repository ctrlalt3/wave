# ================================================================
# Wave (SoundDrop) — Variables de entorno
# Copia este archivo como .env si necesitas sobreescribir valores
# ================================================================

# Puerto del servidor (por defecto: 5002, nginx proxea desde 5000)
PORT=5002

# Spotify: rellena estos valores en .env (solo en el servidor)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
